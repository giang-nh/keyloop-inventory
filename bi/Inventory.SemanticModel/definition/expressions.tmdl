/// Folder that holds vehicles.csv and actions.csv, downloaded from the API's export endpoints.
/// Each machine points this parameter at its own copy of the repo (bi\data), so no query has to be
/// edited. See bi/README.md for how to download the files.
expression CsvFolder = "D:\keyloop-inventory\bi\data" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: b0000001-0000-4000-8000-000000000001
	queryGroup: Parameters

	annotation PBI_ResultType = Text

	annotation PBI_NavigationStepName = Navigation

